# Server
PORT=3000
NODE_ENV=development

# WhatsApp Cloud API (Coexistence-enabled number — same Business App number)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_API_VERSION=v21.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com

# Agent / handover
AGENT_HANDOVER_NUMBER=
AGENT_NOTIFY_WEBHOOK_URL=

# Session
SESSION_TTL_MS=86400000
SESSION_STORE_PATH=./data/sessions
# Set SESSION_STORE=redis and REDIS_URL if Redis is available
SESSION_STORE=file
REDIS_URL=

# FSM behaviour
MAX_INVALID_ATTEMPTS=1
HELP_INTENT_KEYWORDS=help,agent,human,stop,opt out,optout
REOPEN_KEYWORDS=restart,start,hello,hi

# Content / link placeholders (resolved into copy keys; leave blank until human provides)
APPLICATION_LINK=
STOCK_LINK=

# Lead logger: console | file | json
LEAD_LOGGER=console
LEAD_LOG_PATH=./data/logs/leads.jsonl
