# Server
PORT=3000
NODE_ENV=development

# Public https origin Meta will call (no trailing slash).
# Local: ngrok / cloudflared URL. Production: https://your-host
PUBLIC_BASE_URL=

# WhatsApp Cloud API — same Business App number (Coexistence)
# From Meta Developer > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com

# Agent / handover
AGENT_HANDOVER_NUMBER=
AGENT_NOTIFY_WEBHOOK_URL=

# Agent desk (staff browser inbox) — https://your-host/agent
AGENT_DESK_ENABLED=true
AGENT_DESK_PASSWORD=
AGENT_TRANSCRIPT_PATH=./data/transcripts
AGENT_SHORTCUTS_PATH=./data/agent/shortcuts.json
AGENT_LABELS_PATH=./data/agent/labels.json
# Cloud chat history (Supabase / Postgres). See docs/SUPABASE_SETUP.md
# When DATABASE_URL is set, transcripts use Postgres instead of local files.
DATABASE_URL=
MESSAGE_STORE=

# Session
SESSION_TTL_MS=86400000
SESSION_STORE_PATH=./data/sessions
# Set SESSION_STORE=redis and REDIS_URL if Redis is available
SESSION_STORE=file
REDIS_URL=

# FSM behaviour
MAX_INVALID_ATTEMPTS=1
HELP_INTENT_KEYWORDS=help,agent,human,stop,opt out,optout
REOPEN_KEYWORDS=restart,start,hello,hi

# No-reply follow-ups (waiting on an active question)
FOLLOW_UP_ENABLED=true
FOLLOW_UP_FIRST_MS=1800000
FOLLOW_UP_INTERVAL_MS=14400000
FOLLOW_UP_MAX=3
FOLLOW_UP_POLL_MS=60000
FOLLOW_UP_INCLUDE_PROMPT=true
FOLLOW_UP_NOTIFY_ON_EXHAUSTED=false

# Content / link placeholders (required for qualify + stock steps)
APPLICATION_LINK=https://forms.gle/eZq13HF91GpGqivU9
STOCK_LINK=

# Lead logger: console | file | json — use file for launch
LEAD_LOGGER=file
LEAD_LOG_PATH=./data/logs/leads.jsonl
